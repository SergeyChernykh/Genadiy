generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UploadStatus {
  STORED
  FAILED
}

enum ProcessingJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ExtractionMethod {
  TEXT_LAYER
  OCR
  MIXED
}

enum RagContentBlockType {
  TEXT
  TABLE
}

model UploadRecord {
  id                   String                  @id @default(uuid())
  status               UploadStatus
  telegramUserId       BigInt
  telegramChatId       BigInt
  telegramMessageId    Int
  telegramFileId       String
  telegramFileUniqueId String?
  telegramFileType     String
  originalFileName     String?
  mimeType             String?
  fileSizeBytes        BigInt?
  bucket               String?
  objectKey            String?
  etag                 String?
  failureMessage       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  processingJobs       DocumentProcessingJob[]
  extractionRuns       DocumentExtractionRun[]
  documentTexts        DocumentText[]
  pageTexts            DocumentPageText[]
  ragIndexJobs         DocumentRagIndexJob[]
  ragContentBlocks     DocumentContentBlock[]
  ragChunks            DocumentChunk[]

  @@index([telegramUserId])
  @@index([telegramChatId, telegramMessageId])
  @@index([status])
}

model DocumentProcessingJob {
  id             String                  @id @default(uuid())
  uploadRecordId String                  @unique
  uploadRecord   UploadRecord            @relation(fields: [uploadRecordId], references: [id], onDelete: Cascade)
  status         ProcessingJobStatus     @default(PENDING)
  attempts       Int                     @default(0)
  maxAttempts    Int                     @default(3)
  claimedBy      String?
  lockedAt       DateTime?
  nextRunAt      DateTime                @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  skipReason     String?
  metadataJson   Json?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  extractionRuns DocumentExtractionRun[]

  @@index([status, nextRunAt])
  @@index([lockedAt])
}

model DocumentExtractionRun {
  id                String                 @id @default(uuid())
  uploadRecordId    String
  uploadRecord      UploadRecord           @relation(fields: [uploadRecordId], references: [id], onDelete: Cascade)
  processingJobId   String?
  processingJob     DocumentProcessingJob? @relation(fields: [processingJobId], references: [id], onDelete: SetNull)
  status            ProcessingJobStatus
  method            ExtractionMethod?
  ocrLanguages      String?
  pageCount         Int?
  durationMs        Int?
  averageConfidence Float?
  metadataJson      Json?
  toolVersionsJson  Json?
  errorMessage      String?
  startedAt         DateTime               @default(now())
  completedAt       DateTime?
  documentText      DocumentText?
  pageTexts         DocumentPageText[]

  @@index([uploadRecordId])
  @@index([status])
}

model DocumentText {
  id              String                @id @default(uuid())
  uploadRecordId  String
  uploadRecord    UploadRecord          @relation(fields: [uploadRecordId], references: [id], onDelete: Cascade)
  extractionRunId String                @unique
  extractionRun   DocumentExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  rawText         String
  characterCount  Int
  wordCount       Int
  createdAt       DateTime              @default(now())
  ragIndexJobs    DocumentRagIndexJob[]
  contentBlocks   DocumentContentBlock[]

  @@index([uploadRecordId])
}

model DocumentPageText {
  id              String                @id @default(uuid())
  uploadRecordId  String
  uploadRecord    UploadRecord          @relation(fields: [uploadRecordId], references: [id], onDelete: Cascade)
  extractionRunId String
  extractionRun   DocumentExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  pageNumber      Int
  method          ExtractionMethod
  rawText         String
  confidence      Float?
  metadataJson    Json?
  createdAt       DateTime              @default(now())
  contentBlocks   DocumentContentBlock[]

  @@unique([extractionRunId, pageNumber])
  @@index([uploadRecordId])
  @@index([method])
}

model DocumentRagIndexJob {
  id             String              @id @default(uuid())
  uploadRecordId String
  uploadRecord   UploadRecord        @relation(fields: [uploadRecordId], references: [id], onDelete: Cascade)
  documentTextId String
  documentText   DocumentText        @relation(fields: [documentTextId], references: [id], onDelete: Cascade)
  status         ProcessingJobStatus @default(PENDING)
  indexVersion   String
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  claimedBy      String?
  lockedAt       DateTime?
  nextRunAt      DateTime            @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  metadataJson   Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([documentTextId, indexVersion])
  @@index([status, nextRunAt])
  @@index([uploadRecordId])
  @@index([indexVersion])
}

model DocumentContentBlock {
  id             String              @id @default(uuid())
  uploadRecordId String
  uploadRecord   UploadRecord        @relation(fields: [uploadRecordId], references: [id], onDelete: Cascade)
  documentTextId String
  documentText   DocumentText        @relation(fields: [documentTextId], references: [id], onDelete: Cascade)
  pageTextId     String?
  pageText       DocumentPageText?   @relation(fields: [pageTextId], references: [id], onDelete: SetNull)
  indexVersion   String
  blockType      RagContentBlockType
  blockIndex     Int
  pageNumber     Int?
  rawText        String
  aiText         String
  contentHash    String
  characterCount Int
  wordCount      Int
  metadataJson   Json?
  createdAt      DateTime            @default(now())
  chunks         DocumentChunk[]

  @@unique([documentTextId, indexVersion, blockIndex])
  @@index([uploadRecordId])
  @@index([pageTextId])
  @@index([blockType])
  @@index([contentHash])
}

model DocumentChunk {
  id                String                 @id @default(uuid())
  uploadRecordId    String
  uploadRecord      UploadRecord           @relation(fields: [uploadRecordId], references: [id], onDelete: Cascade)
  contentBlockId    String
  contentBlock      DocumentContentBlock   @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)
  indexVersion      String
  chunkIndex        Int
  textForEmbedding  String
  contentHash       String
  characterCount    Int
  metadataJson      Json?
  createdAt         DateTime               @default(now())
  embedding         DocumentChunkEmbedding?

  @@unique([contentBlockId, chunkIndex])
  @@index([uploadRecordId])
  @@index([indexVersion])
  @@index([contentHash])
}

model DocumentChunkEmbedding {
  id             String        @id @default(uuid())
  chunkId        String        @unique
  chunk          DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  embeddingModel String
  dimensions     Int
  embedding      Unsupported("vector")
  createdAt      DateTime      @default(now())

  @@index([embeddingModel])
  @@index([dimensions])
}
