BOT_TOKEN=123456:replace-with-your-telegram-bot-token
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321
DATABASE_URL=postgresql://telegram:telegram@localhost:5432/telegram_documents

# Optional. Set this when Telegram API is only reachable through a proxy.
# TELEGRAM_PROXY_URL=http://127.0.0.1:12334

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=telegram-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

MAX_FILE_BYTES=20971520
